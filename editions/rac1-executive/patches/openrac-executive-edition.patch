diff --git a/games/rac1/tools/boot_elf.py b/games/rac1/tools/boot_elf.py
new file mode 100644
index 00000000..16b765a6
--- /dev/null
+++ b/games/rac1/tools/boot_elf.py
@@ -0,0 +1,120 @@
+#!/usr/bin/env python3
+"""
+Write a bootable executable from the build: retail's container with the
+rebuilt bytes laid over it.
+
+build-sn/rac1.elf is the linked image the audits read (tools/check_image.py,
+tools/check_layout.py). It is not what the console boots: its entry point is
+the first .text symbol rather than crt0's _start, it is laid out as two
+PT_LOAD segments, and the VU0 microcode at the front of retail's image
+(0x100080-0x112380) is not linked (rac1.ld.sh). So the boot file is made the
+other way round from check_image.py: start from baserom/SCES_509.16, and
+copy every allocated PROGBITS section of rac1.elf that lies inside retail's
+single loaded segment over the same addresses. Sections parked outside it
+(.reginfo/.mdebug at 0x2400000) are left out.
+
+With an unmodified tree the result differs from retail only inside the
+decompiled near-misses, which is printed, so the output doubles as a check.
+
+Usage: python tools/boot_elf.py [-o build-sn/SCES_509.16]
+"""
+import argparse
+import hashlib
+import sys
+from pathlib import Path
+
+from elftools.elf.elffile import ELFFile
+
+RETAIL = Path("baserom/SCES_509.16")
+LINKED = Path("build-sn/rac1.elf")
+SHF_ALLOC = 0x2
+
+
+def add_segment(image: bytearray, addr: int, data: bytes) -> bytearray:
+    """IMAGE with DATA appended as one more PT_LOAD at ADDR. Retail's program
+    header table (one entry at 0x34) is followed by zeros up to the first
+    segment at 0x1000, so the new entry goes right after it. The data goes
+    after the file's end (the section headers), at an offset congruent to
+    ADDR modulo the page size, as the ELF rules want."""
+    import struct
+    e_phoff, = struct.unpack_from("<I", image, 28)
+    e_phentsize, e_phnum = struct.unpack_from("<HH", image, 42)
+    new_hdr = e_phoff + e_phnum * e_phentsize
+    if any(image[new_hdr:new_hdr + e_phentsize]):
+        raise SystemExit("no room for another program header")
+    page = 0x1000
+    offset = len(image)
+    offset += (addr - offset) % page
+    image = image + bytes(offset - len(image)) + data
+    image += bytes((-len(image)) % 16)
+    # PT_LOAD, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, PF_R|PF_W|PF_X, p_align
+    struct.pack_into("<8I", image, new_hdr, 1, offset, addr, addr, len(data), len(data), 7, page)
+    struct.pack_into("<H", image, 44, e_phnum + 1)
+    return image
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    ap.add_argument("-o", "--output", type=Path, default=Path("build-sn/SCES_509.16"))
+    ap.add_argument("--segment", metavar="ADDR:FILE", action="append", default=[],
+                    help="add a loadable segment: FILE's bytes at hex address ADDR (a second PT_LOAD "
+                         "the console's loader places in RAM at boot; for code of your own outside "
+                         "retail's image, e.g. a mod's resident code)")
+    args = ap.parse_args()
+
+    if not RETAIL.is_file():
+        print(f"missing {RETAIL} (python3 tools/openrac.py setup rac1/pal)", file=sys.stderr)
+        return 1
+    if not LINKED.is_file():
+        print(f"missing {LINKED} (bash tools/build_sn.sh)", file=sys.stderr)
+        return 1
+
+    retail = bytearray(RETAIL.read_bytes())
+    with RETAIL.open("rb") as f:
+        elf = ELFFile(f)
+        loads = [s for s in elf.iter_segments() if s["p_type"] == "PT_LOAD"]
+        if len(loads) != 1:
+            print(f"{RETAIL}: expected one PT_LOAD, found {len(loads)}", file=sys.stderr)
+            return 1
+        seg = loads[0]
+        seg_vaddr, seg_off, seg_size = seg["p_vaddr"], seg["p_offset"], seg["p_filesz"]
+
+    written = 0
+    changed = 0
+    skipped = []
+    with LINKED.open("rb") as f:
+        elf = ELFFile(f)
+        for sec in elf.iter_sections():
+            if not sec["sh_flags"] & SHF_ALLOC or sec["sh_type"] != "SHT_PROGBITS" or sec["sh_size"] == 0:
+                continue
+            addr, size = sec["sh_addr"], sec["sh_size"]
+            if addr < seg_vaddr or addr + size > seg_vaddr + seg_size:
+                skipped.append(f"{sec.name} 0x{addr:X}+0x{size:X}")
+                continue
+            data = sec.data()
+            off = seg_off + (addr - seg_vaddr)
+            old = retail[off:off + size]
+            changed += sum(1 for a, b in zip(old, data) if a != b)
+            retail[off:off + size] = data
+            written += size
+
+    for spec in args.segment:
+        addr_text, _, file_text = spec.partition(":")
+        addr = int(addr_text, 16)
+        data = Path(file_text).read_bytes()
+        retail = add_segment(retail, addr, data)
+        print(f"added segment: {len(data)} bytes at 0x{addr:08X} from {file_text}")
+
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_bytes(retail)
+    print(f"wrote {args.output}: {len(retail)} bytes, {written} bytes from {LINKED}, "
+          f"{changed} byte(s) changed against retail")
+    if skipped:
+        print("left out (outside retail's loaded segment): " + ", ".join(skipped))
+    print(f"sha1 {hashlib.sha1(retail).hexdigest()}"
+          + (" (identical to retail)" if changed == 0 else ""))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/games/rac1/tools/iso_patch.py b/games/rac1/tools/iso_patch.py
new file mode 100644
index 00000000..f2c6e4f8
--- /dev/null
+++ b/games/rac1/tools/iso_patch.py
@@ -0,0 +1,191 @@
+#!/usr/bin/env python3
+"""
+Write a bootable disc image: your own image with the rebuilt executable
+(and optionally the editor's packed level sectors) written in place.
+
+The PAL disc names only three files in its ISO 9660 directory; everything
+else is addressed by absolute sector through the table the game reads at
+startup (editor/disc.py). So a repack that keeps every size is a copy of the
+image with sectors overwritten:
+
+  - the boot executable, `SCES_509.16;1` in the root directory, replaced by
+    tools/boot_elf.py's output (same size, by construction);
+  - optionally the sectors listed in a `patches.tsv` written by
+    `editor/extract.py pack` (first sector, sector count, file), the
+    editor's edited levels, which it sizes to fit where the originals are.
+
+Nothing in the directory or the sector table changes, so the result boots
+wherever the original does. A larger executable or level needs a real
+re-layout (wrench) and is refused here.
+
+Usage:
+  python tools/iso_patch.py [--elf build-sn/SCES_509.16]
+                            [--patches ../../../assets/packed/rac1/patches.tsv]
+                            [-o build-sn/SCES_509.16.iso]
+"""
+import argparse
+import shutil
+import struct
+import sys
+from pathlib import Path
+
+SECTOR = 2048
+TAIL_SECTORS = 32
+IMAGE = Path("baserom/SCES_509.16.iso")
+EXE_NAME = "SCES_509.16;1"
+
+
+def root_directory(f) -> tuple[int, int]:
+    """Extent and size of the root directory, from the primary volume descriptor."""
+    f.seek(16 * SECTOR)
+    pvd = f.read(SECTOR)
+    if pvd[0] != 1 or pvd[1:6] != b"CD001":
+        raise SystemExit("not an ISO 9660 image (no primary volume descriptor)")
+    record = pvd[156:156 + 34]
+    extent, = struct.unpack_from("<I", record, 2)
+    size, = struct.unpack_from("<I", record, 10)
+    return extent, size
+
+
+def find_file(f, name: str) -> tuple[int, int]:
+    """Extent (LBA) and data length of NAME in the root directory."""
+    extent, size = root_directory(f)
+    f.seek(extent * SECTOR)
+    data = f.read(size)
+    pos = 0
+    while pos < len(data):
+        length = data[pos]
+        if length == 0:                      # padding to the next sector
+            pos = (pos // SECTOR + 1) * SECTOR
+            continue
+        rec = data[pos:pos + length]
+        name_len = rec[32]
+        ident = rec[33:33 + name_len].decode("ascii", "replace")
+        if ident == name:
+            return struct.unpack_from("<I", rec, 2)[0], struct.unpack_from("<I", rec, 10)[0]
+        pos += length
+    raise SystemExit(f"{name} not found in the root directory")
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    ap.add_argument("--elf", type=Path, default=Path("build-sn/SCES_509.16"),
+                    help="bootable executable from tools/boot_elf.py")
+    ap.add_argument("--patches", type=Path, help="patches.tsv from `editor/extract.py pack`")
+    ap.add_argument("--append", metavar="FILE@OFFSET", action="append", default=[],
+                    help="place FILE in new sectors at the end of the image and write its first sector "
+                         "and sector count (two u32) at byte OFFSET (hex), e.g. a table-of-contents entry")
+    ap.add_argument("-o", "--output", type=Path, default=Path("build-sn/SCES_509.16.iso"))
+    args = ap.parse_args()
+
+    if not IMAGE.is_file():
+        print(f"missing {IMAGE} (python3 tools/openrac.py setup rac1/pal)", file=sys.stderr)
+        return 1
+    if not args.elf.is_file():
+        print(f"missing {args.elf} (python tools/boot_elf.py)", file=sys.stderr)
+        return 1
+    if args.output.resolve() == IMAGE.resolve():
+        print("refusing to overwrite the original image", file=sys.stderr)
+        return 1
+
+    writes: list[tuple[int, bytes, str]] = []
+    appended = b""
+    with IMAGE.open("rb") as f:
+        lba, size = find_file(f, EXE_NAME)
+        total_sectors = IMAGE.stat().st_size // SECTOR
+    elf = args.elf.read_bytes()
+    if len(elf) <= size:
+        writes.append((lba * SECTOR, elf.ljust(size, b"\0"), f"{EXE_NAME} (sector {lba}, {len(elf)} bytes)"))
+    else:
+        # A larger executable goes in new sectors after the end of the image
+        # (nothing else moves: the disc addresses everything else by sector),
+        # and the directory record and the volume size follow it there.
+        new_lba = total_sectors
+        appended = elf.ljust(-(-len(elf) // SECTOR) * SECTOR, b"\0")
+        writes += directory_updates(IMAGE, EXE_NAME, new_lba, len(elf))
+        print(f"{EXE_NAME} grows from {size} to {len(elf)} bytes: placed at sector {new_lba}, "
+              f"image grows by {len(appended) // SECTOR} sectors")
+
+    for spec in args.append:
+        file_text, _, off_text = spec.rpartition("@")
+        blob = Path(file_text).read_bytes()
+        padded = blob.ljust(-(-len(blob) // SECTOR) * SECTOR, b"\0")
+        first = total_sectors + len(appended) // SECTOR
+        appended += padded
+        writes.append((int(off_text, 16), struct.pack("<2I", first, len(padded) // SECTOR),
+                       f"{Path(file_text).name}: {len(blob)} bytes at sector {first}, entry at 0x{int(off_text, 16):X}"))
+
+    if args.patches:
+        base = args.patches.parent
+        for line in args.patches.read_text().splitlines():
+            if not line.strip() or line.startswith("#"):
+                continue
+            first, count, name = line.split("\t")[:3]
+            first, count = int(first), int(count)
+            blob = (base / name).read_bytes()
+            if len(blob) > count * SECTOR:
+                print(f"{name}: {len(blob)} bytes do not fit in {count} sectors", file=sys.stderr)
+                return 1
+            blob = blob.ljust(count * SECTOR, b"\0")
+            writes.append((first * SECTOR, blob, f"{name} (sectors {first}-{first + count - 1})"))
+
+    if appended:
+        # The game's stream reader reads past the end of a file by up to a few
+        # sectors (seen: one sector past the text table). In the middle of the disc
+        # that lands on the next file; at the end of the image it is an error, so
+        # keep a margin of blank sectors after the last appended file.
+        appended += bytes(TAIL_SECTORS * SECTOR)
+        writes.append((16 * SECTOR + 80, both_endian(total_sectors + len(appended) // SECTOR),
+                       "primary volume descriptor: volume space size"))
+
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    print(f"copying {IMAGE} -> {args.output} ({IMAGE.stat().st_size} bytes)")
+    shutil.copyfile(IMAGE, args.output)
+    changed_total = 0
+    with args.output.open("r+b") as out:
+        for offset, blob, what in writes:
+            out.seek(offset)
+            old = out.read(len(blob))
+            changed = sum(1 for a, b in zip(old, blob) if a != b)
+            changed_total += changed
+            out.seek(offset)
+            out.write(blob)
+            print(f"  wrote {what}: {changed} byte(s) changed")
+        if appended:
+            out.seek(0, 2)
+            out.write(appended)
+            print(f"  appended {len(appended)} bytes ({len(appended) // SECTOR} sectors)")
+    print(f"done: {changed_total} byte(s) differ from the original image"
+          + (f", plus {len(appended)} appended" if appended else ""))
+    return 0
+
+
+def both_endian(value: int) -> bytes:
+    """A 32-bit field as ISO 9660 stores it: little-endian, then big-endian."""
+    return struct.pack("<I", value) + struct.pack(">I", value)
+
+
+def directory_updates(image: Path, name: str, new_lba: int, new_size: int) -> list[tuple[int, bytes, str]]:
+    """Writes that move NAME's root directory record to NEW_LBA/NEW_SIZE
+    (both byte orders, as ISO 9660 stores them)."""
+    with image.open("rb") as f:
+        extent, size = root_directory(f)
+        f.seek(extent * SECTOR)
+        data = f.read(size)
+    pos = 0
+    while pos < len(data):
+        length = data[pos]
+        if length == 0:
+            pos = (pos // SECTOR + 1) * SECTOR
+            continue
+        rec = data[pos:pos + length]
+        if rec[33:33 + rec[32]].decode("ascii", "replace") == name:
+            base = extent * SECTOR + pos
+            return [(base + 2, both_endian(new_lba), f"directory record of {name}: extent"),
+                    (base + 10, both_endian(new_size), f"directory record of {name}: size")]
+        pos += length
+    raise SystemExit(f"{name} not found in the root directory")
+
+
+if __name__ == "__main__":
+    sys.exit(main())

From 64002ea85f3af51b5071ee05d770cc4d720d1319 Mon Sep 17 00:00:00 2001
From: Stephen Clinton <stephen_l43@hotmail.co.nz>
Date: Sat, 17 Oct 2026 03:34:10 +1300
Subject: [PATCH 4/4] fix(rac1/pal): iso_patch.py keeps blank sectors after
 appended files

The game's stream reader reads past the end of a file by up to a few
sectors (seen: one sector past the text table, PCSX2's "Block index is
past the end of file"). In the middle of the disc that lands on the next
file; at the end of the image it is an error and the load stalls. Appended
data is now followed by 32 blank sectors, counted in the volume size.

Verified: an image with the text table appended booted to the title
screen with no read errors in PCSX2's log, where the same image without
the margin stalled at the end of the intro.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 games/rac1/pal/tools/iso_patch.py | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/games/rac1/pal/tools/iso_patch.py b/games/rac1/pal/tools/iso_patch.py
index 5066bb67..f2c6e4f8 100644
--- a/games/rac1/pal/tools/iso_patch.py
+++ b/games/rac1/pal/tools/iso_patch.py
@@ -30,6 +30,7 @@ import sys
 from pathlib import Path
 
 SECTOR = 2048
+TAIL_SECTORS = 32
 IMAGE = Path("baserom/SCES_509.16.iso")
 EXE_NAME = "SCES_509.16;1"
 
@@ -129,6 +130,11 @@ def main() -> int:
             writes.append((first * SECTOR, blob, f"{name} (sectors {first}-{first + count - 1})"))
 
     if appended:
+        # The game's stream reader reads past the end of a file by up to a few
+        # sectors (seen: one sector past the text table). In the middle of the disc
+        # that lands on the next file; at the end of the image it is an error, so
+        # keep a margin of blank sectors after the last appended file.
+        appended += bytes(TAIL_SECTORS * SECTOR)
         writes.append((16 * SECTOR + 80, both_endian(total_sectors + len(appended) // SECTOR),
                        "primary volume descriptor: volume space size"))
 

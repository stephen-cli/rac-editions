#!/usr/bin/env bash
# Refuse a push whose commits add game data (common/check_game_data.py), so
# nothing reaches the public repository that would have to be removed from
# its history. Covers commits the pre-commit hook did not see.
# Enabled per clone with: git config core.hooksPath .githooks
set -euo pipefail
remote=$1
zero=0000000000000000000000000000000000000000
root=$(git rev-parse --show-toplevel)
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # deleting a branch
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$local_sha --not --remotes=$remote"   # a new branch: the commits the remote has on no branch
  else
    range="$remote_sha..$local_sha"
  fi
  echo "check_game_data: $local_ref -> $remote_ref"
  python "$root/common/check_game_data.py" --range "$range" || status=1
done
exit $status
